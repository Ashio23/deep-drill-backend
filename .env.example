NODE_ENV=development
PORT=3000
MONGODB_URI=
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
MAX_SESSIONS=10
CORS_ORIGINS=
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000
SWAGGER_ENABLED=true
AUTH_GOOGLE_ENABLED=false
# Web application OAuth Client ID; must equal Android GOOGLE_WEB_CLIENT_ID.
GOOGLE_CLIENT_ID=
AUTH_FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Select a currently supported version in your Meta app dashboard, e.g. v26.0.
FACEBOOK_GRAPH_API_VERSION=
