JWT_EXPIRES_IN=30d
MAX_SESSIONS=10
CORS_ORIGINS=
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000
SWAGGER_ENABLED=true
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
AUTH_FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
